<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 测试代码直接使用 NullLogger 等；插件工程改为 ExcludeAssets=runtime 后不再传递 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 模块 6/7：模块 6 悬浮窗测试与设置页类型运行期需要 Avalonia 程序集 -->
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <!-- 悬浮窗门控测试需要构造 Window 实例：Headless 平台无需显示设备 -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.17" />
    <!-- 需求 6：通知悬浮窗真实布局测试要测量文本（可交互区域来自文本框坐标），
         Headless 默认的空渲染后端没有字体管理器，文本排版会抛 fonts:SystemFonts 缺失；
         启用 Skia 渲染后端即可用系统字体完成测量（仅测试工程引用，不进插件包） -->
    <PackageReference Include="Avalonia.Skia" Version="11.3.17" />
    <!-- 需求 6：ItemsControl 的数据模板要生成条目容器必须有控件主题（无主题则无 ItemsPresenter）。
         测试内按需给当前测试应用实例挂上，不改变其他测试的会话环境 -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CyberTechRep.Plugin\CyberTechRep.Plugin.csproj" />
    <ProjectReference Include="..\..\src\CyberTechRep.Shared\CyberTechRep.Shared.csproj" />
  </ItemGroup>

</Project>
