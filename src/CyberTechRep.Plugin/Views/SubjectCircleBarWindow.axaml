<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="64" d:DesignHeight="440"
        x:Class="CyberTechRep.Plugin.Views.SubjectCircleBarWindow"
        Title="CyberTechRep 学科圆圈" Width="64" Height="440" MinWidth="48" MinHeight="120"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="False"
        Topmost="True" Background="Transparent" FontSize="12">

  <!-- 拖放视觉提示：拖入文件悬停于学科圆圈上时高亮该圆圈（Copy 可用）；
       注意：窗口开启鼠标穿透（WS_EX_TRANSPARENT）后收不到任何鼠标/拖放事件，拖放仅在穿透关闭时可用 -->
  <Window.Styles>
    <Style Selector="Button.circle.drop-target">
      <Setter Property="BorderBrush" Value="#FF2196F3" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="#E6E3F2FD" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="14" Background="#88F2F2F2" BorderBrush="#44000000" BorderThickness="1"
          PointerPressed="OnBarPointerPressed">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Grid.Row="0" Padding="4" HorizontalScrollBarVisibility="Auto">
        <!-- 排列方向由设置（Orientation）驱动，运行期切换 ItemsPanel 的 StackPanel 方向；
             横向排列时允许横向滚动，避免内容被裁掉 -->
        <ItemsControl x:Name="CircleList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="circle" Click="OnCircleClick" Width="48" Height="48"
                      CornerRadius="24" Padding="2" HorizontalAlignment="Center"
                      Background="#D0FFFFFF" BorderBrush="#33000000" BorderThickness="1">
                <Button.ContextMenu>
                  <ContextMenu Opened="OnMenuOpened">
                    <MenuItem Header="上移" Click="OnMoveUpClick" />
                    <MenuItem Header="下移" Click="OnMoveDownClick" />
                  </ContextMenu>
                </Button.ContextMenu>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" MaxHeight="40" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 拖放导入结果瞬态提示（非致命反馈：跳过/失败原因等，几秒后自动隐藏） -->
      <Border x:Name="DropStatusHost" Grid.Row="0" IsVisible="False" HorizontalAlignment="Center"
              VerticalAlignment="Bottom" Margin="0,0,0,34" CornerRadius="6" Background="#F0333333"
              MaxWidth="200">
        <TextBlock x:Name="DropStatusText" Margin="8,4" TextWrapping="Wrap" Foreground="White" FontSize="11" />
      </Border>

      <!-- 底部控件条：快捷设置菜单「⋯」 + 关闭（关闭与菜单入口统一放到底部；
           无边框置顶、空白处拖拽、穿透/固定等既有行为不变；× 隐藏后设置页可再唤出） -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2"
                  Margin="0,0,0,2">
        <Button x:Name="QuickMenuButton" Content="⋯" Width="22" Height="22" Padding="0"
                Background="Transparent" BorderThickness="0" ToolTip.Tip="悬浮窗快捷设置" />
        <Button Content="×" Click="OnHideClick" Width="22" Height="22" Padding="0"
                Background="Transparent" BorderThickness="0" ToolTip.Tip="隐藏圆圈栏（设置页可再唤出）" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
