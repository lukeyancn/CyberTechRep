<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CyberTechRep.Plugin.Views"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="480"
        x:Class="CyberTechRep.Plugin.Views.NoticeSuspensionWindow"
        x:CompileBindings="True"
        Title="CyberTechRep 通知" Width="320" Height="480" MinWidth="220" MinHeight="160"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="False"
        Topmost="True" Background="Transparent" FontSize="14">

  <Window.Resources>
    <!-- 正文（可选中复制的只读文本）字号：由控制器按悬浮窗设置「字号」写入
         （见 IOverlayContentFontSizeAware），下方样式据此覆盖主题自带字号。 -->
    <x:Double x:Key="CyberTechRepOverlayContentFontSize">14</x:Double>
  </Window.Resources>

  <Window.Styles>
    <!-- 正文必须显式设字号：宿主主题（Fluent）给 TextBox 的 ControlTheme 自带 FontSize，
         优先级高于窗口级继承——只设窗口字号时正文不会变（用户实测缺陷）。
         用样式 + 动态资源：样式优先级高于 ControlTheme，且滚动中新生成的行也自动生效。 -->
    <Style Selector="TextBox.notice-content">
      <Setter Property="FontSize" Value="{DynamicResource CyberTechRepOverlayContentFontSize}" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="10" Background="#F2FAFAFA" BorderBrush="#33000000" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 标题栏：拖拽区 + 快捷设置菜单（右上角） + 关闭（隐藏，托盘/设置页可再唤出） -->
      <Border Grid.Row="0" Background="#14000000" CornerRadius="10,10,0,0"
              PointerPressed="OnHeaderPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="12,8,8,8">
          <TextBlock Text="通知" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button x:Name="QuickMenuButton" Content="⋯" Padding="6,0" MinWidth="28" Background="Transparent"
                    BorderThickness="0" ToolTip.Tip="悬浮窗快捷设置" />
            <Button Content="×" Click="OnHideClick"
                    Padding="6,0" MinWidth="28" Background="Transparent" BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 通知列表 / 空状态 -->
      <Panel Grid.Row="1">
        <TextBlock x:Name="EmptyText" Text="暂无未读通知" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Opacity="0.6" IsVisible="True" />
        <ScrollViewer x:Name="NoticeScroll" Padding="8,4">
          <ItemsControl x:Name="NoticeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NoticeRow}">
                <Border Margin="0,4" CornerRadius="6" Background="#FFFFFFFF" BorderBrush="#22000000"
                        BorderThickness="1" Padding="8">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <!-- 需求 6：通知内容鼠标可选中复制、不可编辑。
                         只读 TextBox（IsReadOnly=true，不显示光标，IsTabStop=false 不抢焦点），
                         显式给 SelectionBrush 保证选中高亮可见。
                         穿透模式下整窗不再一律穿透：本窗实现 IOverlayInteractiveRegionProvider，
                         把下面这些只读文本框的并集（裁剪到滚动视口内）作为可交互区域，
                         经 DesktopLevelPinner 的 WM_NCHITTEST 分流保留鼠标——区域内可选中复制，
                         区域外（标题栏/按钮/空白）仍然穿透。 -->
                    <TextBox Grid.Column="0" Grid.Row="0" Classes="notice-content"
                             Text="{Binding Item.Content, Mode=OneWay}"
                             IsReadOnly="True" IsTabStop="False"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             MinHeight="0" Cursor="IBeam" VerticalAlignment="Center"
                             SelectionBrush="#5C2F6FEB" SelectionForegroundBrush="#FF101010"
                             ToolTip.Tip="可选中复制（内容不可编辑）">
                      <!-- 悬浮窗带 WS_EX_NOACTIVATE（不抢焦点），键盘 Ctrl+C 可能收不到：
                           显式提供右键「复制/全选」菜单，保证选中复制在任何交互模式下都可用。 -->
                      <TextBox.ContextMenu>
                        <ContextMenu Opened="OnNoticeContentMenuOpened">
                          <MenuItem Header="复制" InputGesture="Ctrl+C" Click="OnCopyNoticeContentClick" />
                          <MenuItem Header="全选" InputGesture="Ctrl+A" Click="OnSelectAllNoticeContentClick" />
                        </ContextMenu>
                      </TextBox.ContextMenu>
                    </TextBox>
                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                      <Button Content="{Binding ButtonText}"
                              Click="OnRowActionButtonClick" Padding="8,3" />
                      <Button Content="转为作业" Click="OnNoticeToHomeworkClick"
                              Padding="8,3" FontSize="11" VerticalAlignment="Center"
                              Background="Transparent" BorderThickness="0"
                              ToolTip.Tip="把该通知转为作业：选择学科后写入作业存档，通知存档移除" />
                    </StackPanel>
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding TimeText}"
                               FontSize="11" Opacity="0.5" Margin="0,4,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>

      <!-- 底栏：未读/已读视图切换（左下角，会话内记忆） + 角部缩放 Thumb -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                    Margin="10,2,0,2" VerticalAlignment="Center">
          <RadioButton x:Name="UnreadViewRadio" Content="未读" GroupName="CyberTechRepNoticeView"
                       MinWidth="0" Padding="6,2" IsChecked="True"
                       Checked="OnUnreadViewChecked" />
          <RadioButton x:Name="ReadViewRadio" Content="已读" GroupName="CyberTechRepNoticeView"
                       MinWidth="0" Padding="6,2"
                       Checked="OnReadViewChecked" />
        </StackPanel>
        <Thumb Grid.Column="1" x:Name="ResizeThumb" Width="16" Height="16" Margin="0,0,2,2"
               Opacity="0.4" DragDelta="OnResizeDragDelta">
          <Thumb.Template>
            <ControlTemplate>
              <Border CornerRadius="2" Background="#40000000" />
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Grid>
  </Border>
</Window>
