<local:CyberTechRepSettingsPageBase
    x:Class="CyberTechRep.Plugin.Controls.SettingsPages.AiSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CyberTechRep.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="1100">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" Spacing="10">

            <TextBlock Text="CyberTechRep AI" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="本页集中管理 AI 识别：云端 API 的连接信息，以及哪些识别环节使用 AI。保存后立即生效。"
                       TextWrapping="Wrap" Opacity="0.85"/>

            <!-- 云端 API 接口配置（全插件唯一凭据入口） -->
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="云端 API 接口" FontWeight="SemiBold"/>
                    <TextBlock Text="在这里填写云端 AI 服务的连接信息（整个插件只有本页需要填）。不填也能正常使用：即使下面选了「唯一识别」或「后补识别」，插件也会自动跳过 AI，改用关键词识别。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ToggleSwitch Content="启用 AI 识别（总开关；关闭后下面所有用途都不再调用 AI）"
                                  IsChecked="{Binding Settings.Ai.AiEnabled}"/>
                    <TextBlock Text="服务商类型"/>
                    <ComboBox SelectedIndex="{Binding CloudProviderIndex, Mode=TwoWay}" MinWidth="240"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="OpenAI 兼容接口（多数服务商可选）"/>
                        <ComboBoxItem Content="Anthropic 接口（Claude 官方）"/>
                    </ComboBox>
                    <TextBlock Text="API 地址（按服务商提供的接口地址填写，例如 https://api.example.com/v1）"/>
                    <TextBox Text="{Binding Settings.Ai.CloudEndpoint}"
                             Watermark="https://api.example.com/v1"/>
                    <TextBlock Text="API Key（只保存在本机并加密，输入时不显示明文，也不会写进日志）"/>
                    <TextBox Text="{Binding CloudApiKeyPlain, Mode=TwoWay}" PasswordChar="●"/>
                    <TextBlock Text="模型名称"/>
                    <TextBox Text="{Binding Settings.Ai.CloudModelName}"/>
                    <TextBlock Text="每天最多调用多少次（防止用量失控；超出后当天自动改用关键词识别；0 = 不限制）"/>
                    <NumericUpDown Value="{Binding Settings.Ai.CloudDailyCallLimit}" Minimum="0"
                                   Maximum="100000" Increment="10"/>
                    <TextBlock Text="识别可信度阈值（AI 判断的可信度低于这个值时，消息转入人工确认队列）"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Settings.Ai.ConfidenceThreshold}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="{Binding ConfidenceThresholdText}" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- 用途① 学科分类 -->
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="① 通知作业学科分类" FontWeight="SemiBold"/>
                    <TextBlock Text="判断作业消息属于哪个学科（数学、语文、英语等）。后补识别（默认）：先用关键词判断，判断不了才问 AI；唯一识别：直接让 AI 判断。"
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <ComboBox SelectedIndex="{Binding SubjectClassifyModeIndex}" MinWidth="180" HorizontalAlignment="Left">
                        <ComboBoxItem Content="关闭（不用 AI）"/>
                        <ComboBoxItem Content="唯一识别（直接用 AI 判断）"/>
                        <ComboBoxItem Content="后补识别（先关键词，判断不了再问 AI）"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 用途② 消息二分类 -->
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="② 通知/作业二分类" FontWeight="SemiBold"/>
                    <TextBlock Text="判断一条消息是通知还是作业。默认全部用关键词判断，关键词都没命中时算通知；本项默认关闭（不用 AI）。后补识别：关键词判断不了时才问 AI；唯一识别：每条消息都问 AI。"
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <ComboBox SelectedIndex="{Binding MessageClassifyModeIndex}" MinWidth="180" HorizontalAlignment="Left">
                        <ComboBoxItem Content="关闭（不用 AI）"/>
                        <ComboBoxItem Content="唯一识别（每条消息都问 AI）"/>
                        <ComboBoxItem Content="后补识别（关键词判断不了才问 AI）"/>
                    </ComboBox>
                    <TextBlock Text="⚠ 费用提示：选「唯一识别」后，每收到一条消息都会调用一次 AI，会持续产生 API 费用并消耗每天的调用次数，请确认后再开启。"
                               TextWrapping="Wrap" Foreground="#B8860B"/>
                </StackPanel>
            </Border>

            <!-- 用途③ 无关键词兜底 -->
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="③ 无关键词消息兜底识别" FontWeight="SemiBold"/>
                    <TextBlock Text="消息里没有任何通知 / 作业关键词时（默认算通知），先试着识别学科：能确认学科的按作业归档，确认不了仍算通知。本项默认关闭（不用 AI）。后补识别：先查学科关键词再问 AI；唯一识别：直接问 AI。"
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <ComboBox SelectedIndex="{Binding NoKeywordFallbackModeIndex}" MinWidth="180" HorizontalAlignment="Left">
                        <ComboBoxItem Content="关闭（不用 AI）"/>
                        <ComboBoxItem Content="唯一识别（直接问 AI）"/>
                        <ComboBoxItem Content="后补识别（先查关键词再问 AI）"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 用途④ 文件分类（说明性，无独立模式） -->
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="④ 文件分类" FontWeight="SemiBold"/>
                    <TextBlock Text="文件跟着它所属消息的学科归档（识别完成后自动移动到「学科/日期」目录），没有单独的模式开关，跟随上面第 ① 项的选择。"
                               TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- AI 采样参数 -->
            <Expander Header="高级：AI 回答的随机程度" IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,6">
                    <TextBlock Text="AI 回答的随机性（0 = 最稳定；识别分类建议保持 0，一般不用改）"/>
                    <NumericUpDown Value="{Binding Settings.Ai.CloudTemperature}" Minimum="0" Maximum="2"
                                   Increment="0.1" FormatString="0.0"/>
                </StackPanel>
            </Expander>

            <Button Content="保存并应用" Click="OnSaveClicked" HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:CyberTechRepSettingsPageBase>
