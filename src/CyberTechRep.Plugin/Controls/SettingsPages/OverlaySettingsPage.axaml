<local:CyberTechRepSettingsPageBase
    x:Class="CyberTechRep.Plugin.Controls.SettingsPages.OverlaySettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CyberTechRep.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1000">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" Spacing="10">

            <TextBlock Text="悬浮窗设置" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="每个悬浮窗都能单独设置位置、大小和显示方式。默认贴在桌面最底层：其它窗口都会挡住它，按 Win+D 显示桌面也不会消失；打开「置顶」后它会显示在所有窗口上方。「固定」= 不能拖动和缩放；「鼠标穿透」= 鼠标点击直接穿过悬浮窗。"
                       TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"/>

            <ToggleSwitch Content="随 ClassIsland 启动"
                          IsChecked="{Binding Settings.Overlays.LaunchWithHost}"/>

            <!-- 通知悬浮窗 -->
            <Expander Header="通知悬浮窗" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="高度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Notice.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Notice.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Notice.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过悬浮窗）"
                                  IsChecked="{Binding Settings.Overlays.Notice.ClickThrough}"/>
                    <ToggleSwitch Content="显示悬浮窗" IsChecked="{Binding Settings.Overlays.Notice.Visible}"/>
                    <Button Content="复位通知悬浮窗" Click="OnResetNoticeClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 作业悬浮窗 -->
            <Expander Header="作业悬浮窗" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="高度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Homework.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Homework.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Homework.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过悬浮窗）"
                                  IsChecked="{Binding Settings.Overlays.Homework.ClickThrough}"/>
                    <ToggleSwitch Content="显示悬浮窗" IsChecked="{Binding Settings.Overlays.Homework.Visible}"/>
                    <Button Content="复位作业悬浮窗" Click="OnResetHomeworkClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 学科文件悬浮窗 -->
            <Expander Header="学科文件悬浮窗（点击圆圈栏打开）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Files.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Files.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Files.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="高度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Files.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Files.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Files.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Files.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Files.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过悬浮窗）"
                                  IsChecked="{Binding Settings.Overlays.Files.ClickThrough}"/>
                    <ToggleSwitch Content="显示悬浮窗（默认隐藏；点击圆圈栏才会出现）"
                                  IsChecked="{Binding Settings.Overlays.Files.Visible}"/>
                    <Button Content="复位学科文件悬浮窗" Click="OnResetFilesClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 学科圆圈启动器 -->
            <Expander Header="学科圆圈启动器（点击圆圈打开或切换学科文件悬浮窗）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Circle.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Circle.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度（横向排列时调大、纵向排列时调小）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Circle.Width}" Minimum="48" Maximum="4000"/>
                    <TextBlock Text="高度（纵向排列时调大、横向排列时调小）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Circle.Height}" Minimum="48" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Circle.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Circle.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Circle.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Circle.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过圆圈栏）"
                                  IsChecked="{Binding Settings.Overlays.Circle.ClickThrough}"/>
                    <ToggleSwitch Content="显示圆圈栏"
                                  IsChecked="{Binding Settings.Overlays.Circle.Visible}"/>
                    <Button Content="复位圆圈栏" Click="OnResetCircleClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 未绑定学科选择悬浮窗 -->
            <Expander Header="未绑定学科选择悬浮窗（发送者没绑定学科时弹出）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="消息需要判断学科、但发送者还没绑定过学科时弹出这个窗口，显示发送者、群和消息内容，点一个学科就完成绑定，并按该学科归档。是否弹出还取决于「CyberTechRep 词表编辑」页里的学科识别方式。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <TextBlock Text="➜ 点选后记下的绑定，可以在「CyberTechRep 词表编辑」页的「成员学科绑定」里统一增删改；群 OpenID 留空表示对所有群生效。保存后立即生效。"
                               TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Selection.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Selection.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Selection.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="高度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Selection.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Selection.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Selection.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Selection.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Selection.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过悬浮窗）"
                                  IsChecked="{Binding Settings.Overlays.Selection.ClickThrough}"/>
                    <ToggleSwitch Content="显示悬浮窗（触发时自动弹出；这个开关控制当前是否显示）"
                                  IsChecked="{Binding Settings.Overlays.Selection.Visible}"/>
                    <Button Content="复位学科选择悬浮窗" Click="OnResetSelectionClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 图片悬浮窗（收到图片自动展示） -->
            <Expander Header="图片悬浮窗（收到图片自动展示）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="群里发来的图片保存后会自动加入这个悬浮窗，按收到的顺序排列（最多留 20 张，超过后最早的一张被挤掉），有新图时会自动滚到它。标题栏的「打开」用系统默认看图工具打开当前图片。上面这个开关只控制收到图片是否自动弹出；窗口是否显示由下面的「显示悬浮窗」决定。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ToggleSwitch Content="收到图片自动展示（关闭后图片照常保存，只是不自动弹出）"
                                  IsChecked="{Binding Settings.Overlays.ImageAutoShowOnReceive}"/>
                    <TextBlock Text="位置 X（横向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Image.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="位置 Y（纵向坐标）"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Image.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="宽度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Image.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="高度"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Image.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="透明度（0.1~1.0）"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Image.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="字号"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Image.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="置顶（显示在所有窗口上方；关闭后贴在桌面层，会被其它窗口遮挡）"
                                  IsChecked="{Binding Settings.Overlays.Image.Topmost}"/>
                    <ToggleSwitch Content="固定（不能拖动和缩放，点击也不抢走焦点）"
                                  IsChecked="{Binding Settings.Overlays.Image.Pinned}"/>
                    <ToggleSwitch Content="鼠标穿透（鼠标点击直接穿过悬浮窗）"
                                  IsChecked="{Binding Settings.Overlays.Image.ClickThrough}"/>
                    <ToggleSwitch Content="显示悬浮窗（默认隐藏；上面的自动展示只负责弹出）"
                                  IsChecked="{Binding Settings.Overlays.Image.Visible}"/>
                    <Button Content="复位图片悬浮窗" Click="OnResetImageClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 圆圈栏行为与联动 -->
            <Expander Header="圆圈栏排列与文件悬浮窗联动" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="圆圈排列方向"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ComboBox x:Name="OrientationBox" SelectionChanged="OnOrientationChanged">
                        <ComboBoxItem Content="横向排列" Tag="Horizontal"/>
                        <ComboBoxItem Content="纵向排列" Tag="Vertical"/>
                    </ComboBox>
                    <TextBlock Text="学科文件悬浮窗的显示方式（会记住，重启后保持）"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ComboBox x:Name="ViewModeBox" SelectionChanged="OnViewModeChanged">
                        <ComboBoxItem Content="大图标（图标居中，文件名在图标下方）" Tag="Icons"/>
                        <ComboBoxItem Content="详细列表（小图标在左，完整文件名在右）" Tag="Details"/>
                    </ComboBox>
                    <ToggleSwitch Content="上课时自动弹出对应学科的文件悬浮窗"
                                  IsChecked="{Binding Settings.Overlays.SubjectCircle.AutoOpenWithClass}"/>
                    <TextBlock Text="上课联动延时（秒）：正数表示上课后延迟几秒弹出；负数表示上课前提前几秒弹出；0 = 识别到上课就弹出（默认）。只在上面这个开关打开时生效。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.SubjectCircle.AutoOpenDelaySeconds}"
                                   Minimum="-600" Maximum="600" Increment="5" FormatString="0"
                                   HorizontalAlignment="Left" MinWidth="140"/>
                    <TextBlock Text="学科顺序：圆圈栏显示常用学科，以及已经收到过文件的学科。调整方式：在悬浮窗里右键点圆圈选「上移 / 下移」；也可以在这里编辑，每行一个学科名，没列出的按默认顺序排在后面。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <TextBox x:Name="OrderTextBox" AcceptsReturn="True" MinHeight="120" MaxHeight="260"
                             Watermark="每行一个学科名，没列出的按默认顺序排在后面"
                             LostFocus="OnOrderLostFocus"/>
                </StackPanel>
            </Expander>

            <!-- 作业悬浮窗学科分组顺序 -->
            <Expander Header="作业悬浮窗学科分组顺序" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="作业悬浮窗里学科分组的先后顺序：每行一个学科名，按这里的顺序显示；没列出的学科按名称顺序排在后面。留空（默认）= 全部按名称顺序。保存后立即生效。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <TextBox x:Name="HomeworkGroupOrderTextBox" AcceptsReturn="True" MinHeight="120" MaxHeight="260"
                             Watermark="每行一个学科名，没列出的按名称顺序排在后面"
                             LostFocus="OnHomeworkGroupOrderLostFocus"/>
                </StackPanel>
            </Expander>

            <Button Content="保存并应用" Click="OnSaveClicked" HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:CyberTechRepSettingsPageBase>
