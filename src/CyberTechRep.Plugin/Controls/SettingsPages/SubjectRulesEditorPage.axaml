<local:CyberTechRepSettingsPageBase
    x:Class="CyberTechRep.Plugin.Controls.SettingsPages.SubjectRulesEditorPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CyberTechRep.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" Spacing="10">

            <TextBlock Text="词表编辑" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="在这里可以直接编辑学科关键词和通知 / 作业关键词，不用手动改文件。改完点「保存并应用」立即生效。"
                       TextWrapping="Wrap" Opacity="0.75"/>

            <!-- 学科关键词规则 -->
            <Expander Header="学科关键词规则" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="学科名同时会用作文件夹名，不能包含斜杠、冒号、问号等符号。关键词一行一个，出现任意一个就算命中；一条消息同时命中多个学科时，先看命中关键词的个数，多的优先；个数一样再看「优先级」，数值大的优先。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ListBox x:Name="RulesList" ItemsSource="{Binding Rules}" MinHeight="160" MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="110,*,Auto,Auto,Auto" Margin="0,2">
                                    <TextBox Grid.Column="0" Text="{Binding Subject}" Watermark="学科名"/>
                                    <TextBox Grid.Column="1" Text="{Binding KeywordsText}" AcceptsReturn="True"
                                             MinHeight="40" MaxHeight="120" Watermark="关键词，一行一个"
                                             Margin="8,0"/>
                                    <TextBlock Grid.Column="2" Text="优先级" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <NumericUpDown Grid.Column="3" Value="{Binding Priority}" Minimum="-100"
                                                   Maximum="100" Width="110" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="✕" Click="OnDeleteSubjectClicked"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            ToolTip.Tip="删除该学科"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="＋ 添加学科" Click="OnAddSubjectClicked"/>
                        <Button Content="导出到剪贴板" Click="OnExportSubjectsClicked"/>
                        <Button Content="从剪贴板导入" Click="OnImportSubjectsClicked"/>
                        <Button Content="恢复默认" Click="OnRestoreSubjectsClicked"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 通知 / 作业关键词 -->
            <Expander Header="通知 / 作业关键词" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="判断消息是通知还是作业用的关键词，一行一个。通知和作业的关键词如果同时命中，按作业处理。保存后立即生效。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <TextBlock Text="通知关键词" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding NoticeKeywordsText, Mode=TwoWay}" AcceptsReturn="True" Height="80"/>
                    <TextBlock Text="作业关键词" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding HomeworkKeywordsText, Mode=TwoWay}" AcceptsReturn="True" Height="80"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出到剪贴板" Click="OnExportKeywordsClicked"/>
                        <Button Content="从剪贴板导入" Click="OnImportKeywordsClicked"/>
                        <Button Content="恢复默认" Click="OnRestoreKeywordsClicked"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 学科识别方式 -->
            <Expander Header="学科识别方式（成员绑定优先 / 只用关键词）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="成员绑定优先（默认）：先看发消息的人有没有绑定过学科；没绑定就照常用关键词判断；都认不出来时弹出选择窗，让用户点选一个学科。只用关键词：完全忽略成员绑定，也不弹选择窗，只按关键词判断。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="成员绑定优先（默认）" Tag="MemberSelection"/>
                        <ComboBoxItem Content="只用关键词" Tag="Keyword"/>
                    </ComboBox>
                    <ToggleSwitch Content="用「未绑定学科选择悬浮窗」让用户点选学科"
                                  IsChecked="{Binding Settings.SubjectRecognition.SelectionWindowEnabled}"/>
                </StackPanel>
            </Expander>

            <!-- 成员学科绑定管理 -->
            <Expander Header="成员学科绑定" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="给群成员指定固定学科。每行填写群 OpenID、成员 OpenID 和学科：群 OpenID 留空表示对所有群都有效，填了则只对这个群有效；同一个成员既有全局绑定又有本群绑定时，以本群绑定为准。保存后立即生效；在「成员绑定优先」方式下，这个成员发的作业和文件都会归到这个学科。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <ListBox x:Name="BindingsList" ItemsSource="{Binding Bindings}" MinHeight="80" MaxHeight="320">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,120,110,Auto" Margin="0,2">
                                    <TextBox Grid.Column="0" Text="{Binding MemberOpenId}" Watermark="成员 OpenID"/>
                                    <TextBox Grid.Column="1" Text="{Binding GroupOpenId}" Watermark="群（留空=全局）"
                                             Margin="8,0"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SubjectOptions}"
                                              SelectedItem="{Binding Subject}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="✕" Click="OnDeleteBindingClicked"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            ToolTip.Tip="删除该绑定"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="＋ 添加绑定" Click="OnAddBindingClicked"/>
                    </StackPanel>

                    <!-- 危险区：完全重置（重新点一次确认） -->
                    <Separator Margin="0,8,0,0"/>
                    <TextBlock Text="危险区：完全重置学科识别数据" FontWeight="SemiBold" Foreground="Firebrick"/>
                    <TextBlock Text="点这个按钮只会清空和学科识别有关的内容：全部成员学科绑定、插件自动学习到的发送者学科记录，并把学科识别方式恢复为默认（成员绑定优先、显示选择窗）。不会影响作业和通知、已归档的文件、AI 密钥以及其它页面设置。点击后需要在 3 秒内再点一次确认才会执行。"
                               TextWrapping="Wrap" Opacity="0.75"/>
                    <Button x:Name="ResetButton" Content="完全重置（清空绑定和学习记录）" Click="OnResetClicked"
                            HorizontalAlignment="Left" FontWeight="SemiBold"
                            Foreground="Firebrick" BorderBrush="Firebrick"/>
                    <TextBlock Text="{Binding ResetFeedback}" Foreground="Firebrick" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <TextBlock Text="{Binding ValidationMessage}" Foreground="Firebrick" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TransferFeedback}" TextWrapping="Wrap" Opacity="0.85"/>

            <Button Content="保存并应用" Click="OnSaveClicked" HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:CyberTechRepSettingsPageBase>
