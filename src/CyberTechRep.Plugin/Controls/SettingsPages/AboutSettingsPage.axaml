<local:CyberTechRepSettingsPageBase
    x:Class="CyberTechRep.Plugin.Controls.SettingsPages.AboutSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CyberTechRep.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" Spacing="10">

            <!-- 标题 + 一句话说明 -->
            <TextBlock Text="CyberTechRep（ClassIsland 插件）" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="QQ 群消息接管与课堂信息分发：接收班级群消息与文件，自动分类通知/作业、识别学科并在桌面悬浮窗展示。"
                       TextWrapping="Wrap" Opacity="0.85"/>

            <Separator Margin="0,6"/>

            <!-- 版本（动态读取程序集信息，manifest.yml 兜底；不写死） -->
            <TextBlock Text="版本" FontWeight="SemiBold"/>
            <SelectableTextBlock Text="{Binding Info.Version}" FontSize="16"/>

            <!-- 作者 -->
            <TextBlock Text="作者" FontWeight="SemiBold"/>
            <SelectableTextBlock Text="{Binding Info.Author}"/>

            <!-- GitHub 仓库：可复制文本 + 打开仓库 -->
            <TextBlock Text="GitHub 仓库" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SelectableTextBlock Text="{Binding Info.RepositoryUrl}" VerticalAlignment="Center"
                                     TextWrapping="Wrap"/>
                <Button Content="打开仓库" Click="OnOpenRepositoryClicked"/>
                <Button Content="复制链接" Click="OnCopyRepositoryClicked"/>
            </StackPanel>

            <!-- 插件 ID -->
            <TextBlock Text="插件 ID" FontWeight="SemiBold"/>
            <SelectableTextBlock Text="{Binding Info.PluginIdText}"/>

            <!-- 数据目录：可复制路径 + 打开目录（不存在时打开前先创建） -->
            <TextBlock Text="数据目录" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SelectableTextBlock Text="{Binding Info.DataDirectory}" VerticalAlignment="Center"
                                     TextWrapping="Wrap"/>
                <Button Content="打开数据目录" Click="OnOpenDataDirectoryClicked"/>
                <Button Content="复制路径" Click="OnCopyDataDirectoryClicked"/>
            </StackPanel>
            <TextBlock Text="目录不存在时打开会自动创建；设置文件 settings.json 位于该目录下。"
                       FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"/>

            <!-- 运行环境 -->
            <TextBlock Text="运行环境" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text=".NET 版本：" Opacity="0.8" Margin="0,0,8,4"/>
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Info.NetVersion}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="操作系统：" Opacity="0.8" Margin="0,0,8,4"/>
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.OsVersion}"
                                     TextWrapping="Wrap" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="设置文件：" Opacity="0.8" Margin="0,0,8,0"/>
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Info.SettingsFilePath}"
                                     TextWrapping="Wrap"/>
            </Grid>

            <!-- 操作反馈（打开仓库/数据目录/复制；失败只提示不抛） -->
            <TextBox Text="{Binding Feedback, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="False"
                     MinHeight="30" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</local:CyberTechRepSettingsPageBase>
