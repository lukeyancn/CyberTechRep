<local:CyberTechRepSettingsPageBase
    x:Class="CyberTechRep.Plugin.Controls.SettingsPages.MaintenanceSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CyberTechRep.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="900">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="760" Spacing="10">

            <TextBlock Text="维护与排错" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- 日志级别 -->
            <TextBlock Text="日志级别（排查问题时用；Trace 记录最详细、Error 记录最少，平时保持 Info 即可）" FontWeight="SemiBold"/>
            <ComboBox SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}" MinWidth="200">
                <ComboBoxItem Content="Trace"/>
                <ComboBoxItem Content="Debug"/>
                <ComboBoxItem Content="Info"/>
                <ComboBoxItem Content="Warning"/>
                <ComboBoxItem Content="Error"/>
            </ComboBox>

            <ToggleSwitch Content="失败后自动重试（下载或发送失败时自动再试；关闭后失败直接提示）"
                          IsChecked="{Binding Settings.Maintenance.RetryQueueEnabled}"/>
            <TextBlock Text="最多重试几次（超过后标记为「已放弃」，可以在下面的列表里手动重新执行）"/>
            <NumericUpDown Value="{Binding Settings.Maintenance.MaxRetryAttempts}" Minimum="1" Maximum="100"/>

            <!-- 首次启动引导 -->
            <Expander Header="首次启动引导" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="重新打开第一次启动时的欢迎与连接设置向导；已经填过的连接信息会自动带入，不会被清空。"
                               FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"/>
                    <Button Content="重新打开引导" Click="OnReopenWizardClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- 排错面板 -->
            <Expander Header="排错面板（连接状态 / 最近消息 / 待重试任务）" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="{Binding DiagnosticsSummaryText}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" Click="OnRefreshDiagnosticsClicked"/>
                        <Button Content="手动重连" Click="OnReconnectClicked"/>
                    </StackPanel>

                    <TextBlock Text="最近收到的消息（最多 50 条，内容过长会截断，并显示群 OpenID）" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding RecentMessages}" Height="140" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="导出消息记录" FontWeight="SemiBold"/>
                    <TextBlock Text="把最近收到的消息（最多 1000 条）导出成一个 JSONL 文件（记事本也能打开，每行一条消息），包含消息编号、群 OpenID、成员 OpenID、昵称、时间、消息内容、分类结果、学科识别结果和关联文件。导出内容不含 AppSecret、AccessToken、API Key 等密钥。"
                               FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出消息记录" Click="OnExportDumpClicked"/>
                        <TextBox Text="{Binding DumpFeedback, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="False" MinWidth="320"/>
                    </StackPanel>

                    <TextBlock Text="待重试任务" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding RetryQueueLines}" Height="140" FontSize="12"
                             SelectedItem="{Binding SelectedRetryLine, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="重新执行选中任务" Click="OnReplayClicked" HorizontalAlignment="Left"/>
                    <TextBlock Text="在列表里选中一条，再点「重新执行选中任务」；失败次数会清零并立刻重试。"
                               FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"/>

                    <Separator Margin="0,6,0,0"/>

                    <TextBlock Text="NapCat 后台日志（实时刷新）" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding NapCatStatusText}" TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch Content="暂停滚动" IsChecked="{Binding NapCatLogPaused, Mode=TwoWay}"/>
                        <Button Content="清空日志" Click="OnClearNapCatLogClicked" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding NapCatDroppedText}" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="NapCatLogView" Text="{Binding NapCatLogText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12" Height="200"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Expander>

            <!-- 配置导入导出 -->
            <Expander Header="配置导入 / 导出 / 恢复默认" IsExpanded="False">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="导出的设置不含 AppSecret、API Key 等密钥；导入时，本机已保存的密钥不会被覆盖。"
                               FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出设置到剪贴板" Click="OnExportClicked"/>
                        <Button Content="从剪贴板导入设置" Click="OnImportClicked"/>
                        <Button Content="恢复默认设置" Click="OnResetClicked"/>
                    </StackPanel>
                    <TextBox Text="{Binding TransferFeedback, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="False" MinHeight="30"/>
                </StackPanel>
            </Expander>

            <Button Content="保存并应用" Click="OnSaveClicked" HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:CyberTechRepSettingsPageBase>
