<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="64" d:DesignHeight="440"
        x:Class="ClassIng.Plugin.Views.SubjectCircleBarWindow"
        Title="ClassIng 学科圆圈" Width="64" Height="440" MinWidth="48" MinHeight="120"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="False"
        Topmost="True" Background="Transparent" FontSize="12">

  <Border CornerRadius="14" Background="#88F2F2F2" BorderBrush="#44000000" BorderThickness="1">
    <ScrollViewer Padding="4" HorizontalScrollBarVisibility="Auto">
      <!-- 排列方向由设置（Orientation）驱动，运行期切换 ItemsPanel 的 StackPanel 方向；
           横向排列时允许横向滚动，避免内容被裁掉 -->
      <ItemsControl x:Name="CircleList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="circle" Click="OnCircleClick" Width="48" Height="48"
                    CornerRadius="24" Padding="2" HorizontalAlignment="Center"
                    Background="#D0FFFFFF" BorderBrush="#33000000" BorderThickness="1">
              <Button.ContextMenu>
                <ContextMenu Opened="OnMenuOpened">
                  <MenuItem Header="上移" Click="OnMoveUpClick" />
                  <MenuItem Header="下移" Click="OnMoveDownClick" />
                </ContextMenu>
              </Button.ContextMenu>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                         VerticalAlignment="Center" MaxHeight="40" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</Window>
