<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
        x:Class="ClassIng.Plugin.Views.SubjectFilesSuspensionWindow"
        Title="CyberTechRep 学科文件" Width="360" Height="520" MinWidth="220" MinHeight="160"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="False"
        Topmost="True" Background="Transparent" FontSize="14">

  <Border CornerRadius="10" Background="#F2FAFAFA" BorderBrush="#33000000" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- 标题栏：学科名 + 快捷设置菜单（右上角，与通知窗共用 OverlayQuickMenu）+ 隐藏按钮（圆圈栏点击可再次唤出） -->
      <Border Grid.Row="0" Background="#14000000" CornerRadius="10,10,0,0"
              PointerPressed="OnHeaderPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="12,8,8,8">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="学科文件" FontWeight="SemiBold" />
            <TextBlock x:Name="SubjectTitle" FontWeight="SemiBold" Opacity="0.7" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button x:Name="QuickMenuButton" Content="⋯" Padding="6,0" MinWidth="28" Background="Transparent"
                    BorderThickness="0" ToolTip.Tip="悬浮窗快捷设置" />
            <Button Content="×" Click="OnHideClick"
                    Padding="6,0" MinWidth="28" Background="Transparent" BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>

      <Panel Grid.Row="1">
        <TextBlock x:Name="EmptyText" Text="暂无已归档文件" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Opacity="0.6" />

        <!-- 大图标模式：图标大、居中，文件名在图标下方，WrapPanel 流式排列 -->
        <ScrollViewer x:Name="IconsHost" Padding="8,4" IsVisible="True">
          <ItemsControl x:Name="IconsGroups">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6,0,2" Spacing="4">
                  <TextBlock Text="{Binding Date}" FontSize="12" Opacity="0.55" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="OnOpenFileClick" Padding="4" Margin="2"
                               Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center">
                          <StackPanel Width="88" Spacing="4">
                            <Panel Height="48" HorizontalAlignment="Center">
                              <Image Source="{Binding Icon}" Width="40" Height="40"
                                     IsVisible="{Binding HasIcon}" />
                              <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding !HasIcon}" />
                            </Panel>
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis" FontSize="12" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 详细列表模式：小图标在左、完整文件名在右（不省略截断，超长换行）的行列表 -->
        <ScrollViewer x:Name="DetailsHost" Padding="8,4" IsVisible="False">
          <ItemsControl x:Name="DetailsGroups">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6,0,2" Spacing="4">
                  <TextBlock Text="{Binding Date}" FontSize="12" Opacity="0.55" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="OnOpenFileClick" Padding="6,4" Margin="0,1"
                               Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*">
                            <Panel Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top">
                              <Image Source="{Binding Icon}" Width="18" Height="18"
                                     IsVisible="{Binding HasIcon}" />
                              <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding !HasIcon}" />
                            </Panel>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextWrapping="Wrap"
                                       Margin="6,0,0,0" VerticalAlignment="Top" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>

      <!-- 角部缩放 Thumb -->
      <Thumb Grid.Row="2" x:Name="ResizeThumb" Width="16" Height="16" Margin="0,0,2,2"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.4"
             DragDelta="OnResizeDragDelta">
        <Thumb.Template>
          <ControlTemplate>
            <Border CornerRadius="2" Background="#40000000" />
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
