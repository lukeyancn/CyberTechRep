<local:ClassIngSettingsPageBase
    x:Class="ClassIng.Plugin.Controls.SettingsPages.OverlaySettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClassIng.Plugin.Controls.SettingsPages"
    mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1000">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="720" Spacing="10">

            <TextBlock Text="?????" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <ToggleSwitch Content="??? ClassIsland ??"
                          IsChecked="{Binding Settings.Overlays.LaunchWithHost}"/>

            <!-- ????? -->
            <Expander Header="?????" IsExpanded="True">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="X????? DIP?"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="Y????? DIP?"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="????0.1~1.0?"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Notice.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Notice.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="??" IsChecked="{Binding Settings.Overlays.Notice.Topmost}"/>
                    <ToggleSwitch Content="?????" IsChecked="{Binding Settings.Overlays.Notice.Visible}"/>
                    <Button Content="???????" Click="OnResetNoticeClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- ????? -->
            <Expander Header="?????" IsExpanded="True">
                <StackPanel Spacing="10" Margin="0,6">
                    <TextBlock Text="X????? DIP?"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.X}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="Y????? DIP?"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Y}" Minimum="-10000" Maximum="10000"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Width}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.Height}" Minimum="80" Maximum="4000"/>
                    <TextBlock Text="????0.1~1.0?"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding Settings.Overlays.Homework.Opacity}"
                            TickFrequency="0.05"/>
                    <TextBlock Text="??"/>
                    <NumericUpDown Value="{Binding Settings.Overlays.Homework.FontSize}" Minimum="8" Maximum="72"/>
                    <ToggleSwitch Content="??" IsChecked="{Binding Settings.Overlays.Homework.Topmost}"/>
                    <ToggleSwitch Content="?????" IsChecked="{Binding Settings.Overlays.Homework.Visible}"/>
                    <Button Content="???????" Click="OnResetHomeworkClicked" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <Button Content="?????" Click="OnSaveClicked" HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:ClassIngSettingsPageBase>
